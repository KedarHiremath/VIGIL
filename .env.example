# ==============================================================================
# VIGIL Video Forensics - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your desired API keys:
#   cp .env.example .env
#
# Free Tier Models Supported:
# 1. Google Gemini (Recommended - 100% Free Tier with generous limits)
#    - Native multimodal video, audio, and visual reasoning
#    - Models: gemini-2.0-flash, gemini-1.5-flash
#    - Free API Key: https://aistudio.google.com/app/apikey
#
# 2. Groq (Ultra-Fast Inference - 100% Free Tier)
#    - Models: llama-3.3-70b-versatile, llama-3.2-11b-vision-preview, whisper-large-v3
#    - Free API Key: https://console.groq.com/keys
#
# 3. Ollama (100% Free, Local, Private, Offline)
#    - Models: llama3.2-vision, llava, whisper
#    - Download & Install: https://ollama.com
#    - No API key required!
#
# 4. OpenRouter (Free tier models available with ':free' tag)
#    - Models: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.3-70b-instruct:free
#    - Free API Key: https://openrouter.ai/keys
# ==============================================================================

# Active LLM Provider: "gemini", "groq", "ollama", "openrouter", or "mock"
# Default: "gemini" if GEMINI_API_KEY is present; otherwise "mock"
VIGIL_LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini (Recommended for Multimodal Video Forensics)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Fallback / Lightweight model:
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Groq Cloud (Ultra-Fast Reasoning & Audio Transcription)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_AUDIO_MODEL=whisper-large-v3

# ------------------------------------------------------------------------------
# 3. Ollama (Local & Offline Forensics)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# ------------------------------------------------------------------------------
# 4. OpenRouter Free Tier
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ------------------------------------------------------------------------------
# Storage & Artifact Paths
# ------------------------------------------------------------------------------
VIGIL_STORAGE_ROOT=./storage_data
VIGIL_LOG_LEVEL=INFO
