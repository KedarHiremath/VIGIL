# ==============================================================================
# VIGIL Video Forensics - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# Supported Providers
# -------------------
# 1. NVIDIA NIM  ★ Recommended — dual-model setup (VLM + LLM)
#    VLM : Cosmos 3 Nano Reasoner  — video-frame / scene analysis
#    LLM : Nemotron 3 Nano 30B A3B Reasoning  — timeline, Q&A, reports
#    Free hosted trial API key: https://build.nvidia.com
#    Keys start with "nvapi-"
#
# 2. Google Gemini (100% Free Tier with generous limits)
#    Native multimodal: video, audio, images
#    Models: gemini-2.0-flash, gemini-1.5-flash
#    Free API key: https://aistudio.google.com/app/apikey
#
# 3. Groq (Ultra-Fast Inference — 100% Free Tier)
#    Models: openai/gpt-oss-20b, openai/gpt-oss-120b, whisper-large-v3
#    Free API key: https://console.groq.com/keys
#
# 4. Ollama (100% Free, Local, Private, Offline)
#    Models: llama3.2-vision, llava, whisper
#    Download & Install: https://ollama.com
#    No API key required!
#
# 5. OpenRouter (Free-tier models available with ':free' tag)
#    Models: google/gemini-2.0-flash-exp:free
#    Free API key: https://openrouter.ai/keys
# ==============================================================================

# Active LLM Provider: "nvidia_nim", "gemini", "groq", "ollama", "openrouter", or "mock"
# Auto-detected from whichever API key is present when VIGIL_LLM_PROVIDER is unset.
VIGIL_LLM_PROVIDER=nvidia_nim

# ------------------------------------------------------------------------------
# 1. NVIDIA NIM  ★ Recommended — Cosmos 3 Nano Reasoner VLM + Nemotron 3 LLM
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# VLM: physical-scene reasoning from video frames / images
NVIDIA_VLM_MODEL=nvidia/cosmos3-nano-reasoner

# LLM: text reasoning, investigator Q&A, timeline construction, reports
NVIDIA_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Endpoint routing — NVIDIA uses separate base URLs per model family
# (Change ONLY when using self-hosted NIM containers; leave as-is for cloud)
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_BASE_URL=https://ai.api.nvidia.com/v1

# Rate-limiting — gap (seconds) between requests to avoid ResourceExhausted 503
# Increase to 3-5 if still seeing 503s under heavy load
VIGIL_NVIDIA_INTER_REQUEST_DELAY=2.0

# ------------------------------------------------------------------------------
# 2. Google Gemini (Recommended fallback for Multimodal Video Forensics)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Fallback / Lightweight model:
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. Groq Cloud (Ultra-Fast Reasoning & Audio Transcription)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_REASONING_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=openai/gpt-oss-20b
GROQ_AUDIO_MODEL=whisper-large-v3

# ------------------------------------------------------------------------------
# 4. Ollama (Local & Offline Forensics)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# ------------------------------------------------------------------------------
# 5. OpenRouter Free Tier
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ------------------------------------------------------------------------------
# Storage & Artifact Paths
# ------------------------------------------------------------------------------
VIGIL_STORAGE_ROOT=./storage_data
VIGIL_LOG_LEVEL=INFO
